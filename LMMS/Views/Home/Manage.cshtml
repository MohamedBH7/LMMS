@model List<LMMS.Models.BookViewModel>

<div class="container mt-5">
    <h2 class="text-center mb-4">📚 Book Management</h2>
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-warning">
            @TempData["WarningMessage"]
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }
    <!-- Book Form -->
    <div class="card shadow-sm p-4 mb-4">
        <form method="post" asp-action="ManageBook">
            <input type="hidden" name="Id" id="bookId" />
            <div class="row g-3">
                <div class="col-md-3">
                    <input type="text" class="form-control" name="title" placeholder="Book Title" required />
                </div>
                <div class="col-md-3">
                    <input type="text" class="form-control" name="author" placeholder="Author" required />
                </div>
                <div class="col-md-3">
                    <textarea class="form-control" name="description" placeholder="Description"></textarea>
                </div>
                <div class="col-md-2">
                    <input type="number" class="form-control" name="quantity" placeholder="Quantity" required />
                </div>
            </div>
            <div class="mt-3 text-center">
                <button type="submit" name="action" value="Insert" class="btn btn-success px-4">➕ Add</button>
                <button type="submit" name="action" value="Update" class="btn btn-warning px-4">✏️ Update</button>
                <button type="submit" name="action" value="Delete" class="btn btn-danger px-4">🗑️ Delete</button>
            </div>
        </form>
    </div>

    <!-- Search Input -->
    <div class="mb-3">
        <input type="text" id="bookSearch" class="form-control" placeholder="Search books..." onkeyup="filterTable()" />
    </div>

    <!-- Book Table -->
    <div class="card shadow-sm p-4">
        <table id="bookTable" class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Title</th>
                    <th>Author</th>
                    <th>Description</th>
                    <th>Quantity</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="bookTableBody">
                @foreach (var book in Model)
                {
                    <tr>
                        <td>@book.Id</td>
                        <td class="book-title">@book.Title</td>
                        <td class="book-author">@book.Author</td>
                        <td class="book-description">@book.Description</td>
                        <td class="book-quantity">@book.Quantity</td>
                        <td>
                            <button class="btn btn-primary btn-sm" onclick="editBook('@book.Id', '@book.Title', '@book.Author', '@book.Description', '@book.Quantity')">✏️ Edit</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    function filterTable() {
        var input = document.getElementById('bookSearch').value.toLowerCase(); // Get search input
        var tableBody = document.getElementById('bookTableBody');
        var rows = tableBody.getElementsByTagName('tr'); // Get all table rows

        // Loop through all rows and filter based on the input
        for (var i = 0; i < rows.length; i++) {
            var title = rows[i].getElementsByClassName('book-title')[0].textContent.toLowerCase();
            var author = rows[i].getElementsByClassName('book-author')[0].textContent.toLowerCase();
            var description = rows[i].getElementsByClassName('book-description')[0].textContent.toLowerCase();
            var quantity = rows[i].getElementsByClassName('book-quantity')[0].textContent.toLowerCase();

            // Check if the row matches the search query
            if (title.includes(input) || author.includes(input) || description.includes(input) || quantity.includes(input)) {
                rows[i].style.display = ''; // Show row
            } else {
                rows[i].style.display = 'none'; // Hide row
            }
        }
    }

    function editBook(id, title, author, description, quantity) {
        $('#bookId').val(id);
        $('input[name="title"]').val(title);
        $('input[name="author"]').val(author);
        $('textarea[name="description"]').val(description);
        $('input[name="quantity"]').val(quantity);
    }
</script>

<style>
    .table-responsive {
        overflow-x: auto;
    }

    .animate__animated {
        animation-duration: 1s;
        animation-fill-mode: both;
    }
</style>
