@model IEnumerable<LMMS.Models.BookSection>

@{
    ViewData["Title"] = "Manage Sections";
}

@section Scripts {
    <script>
        // Function to filter the table based on section names
        function filterSections() {
            var input = document.getElementById('sectionSearch').value.toLowerCase();
            var table = document.getElementById('sectionsTable');
            var rows = table.getElementsByTagName('tr');

            for (var i = 1; i < rows.length; i++) {
                var sectionName = rows[i].getElementsByClassName('section-name')[0].textContent.toLowerCase();

                if (sectionName.includes(input)) {
                    rows[i].style.display = "";
                } else {
                    rows[i].style.display = "none";
                }
            }
        }
    </script>
}

<h1>Manage Sections</h1>
<!-- Add Section Form -->
<br />
<form asp-action="AddSection" method="post">
    <div class="form-group">
        <label for="SectionName">New Section Name</label>
        <input type="text" class="form-control" id="SectionName" name="SectionName" required />
    </div>
    <button type="submit" class="btn btn-primary">Add Section</button>
</form>
<br />

<!-- Search Input -->
<div class="mb-3">
    <input type="text" id="sectionSearch" class="form-control" placeholder="Search Sections" onkeyup="filterSections()" />
</div>

<!-- Sections Table -->
<table id="sectionsTable" class="table">
    <thead>
        <tr>
            <th>Section Name</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var sec in Model)
        {
            <tr>
                <td class="section-name">@sec.SectionName</td>
                <td>
                    <!-- Edit Section Form -->
                    <form asp-action="UpdateSection" method="post" style="display:inline;">
                        <input type="hidden" name="Id" value="@sec.Id" />
                        <input type="text" name="SectionName" value="@sec.SectionName" />
                        <button type="submit" class="btn btn-primary">Update</button>
                    </form>

                    <!-- Remove Section Form -->
                    <form asp-action="RemoveSection" method="post" style="display:inline;">
                        <input type="hidden" name="Id" value="@sec.Id" />
                        <button type="submit" class="btn btn-danger">Remove</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

